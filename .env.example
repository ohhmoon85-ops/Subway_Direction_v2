# ── 필수 (Vercel 운영 배포)
# QR 서명 비밀키. 길고 무작위인 값으로. 바꾸면 이미 인쇄한 표지가 모두 무효가 된다.
QR_SECRET=
# 관리자 세션 서명 키
SESSION_SECRET=
# 관리자 계정: 이름:역할:비밀번호해시[:TOTP비밀키]  여러 명은 ; 로 구분
# 역할 = operator | field | viewer,  해시는 `npm run hash-password -- 비밀번호`
ADMIN_USERS=
# Supabase: URL = https://<프로젝트ID>.supabase.co, 키 = Settings → API Keys → Secret keys 의 sb_secret_… (예전 service_role 키도 가능). 서버에서만 쓰인다.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── 선택
# QR에 넣을 주소 (없으면 Vercel 운영 도메인을 자동 사용)
PUBLIC_BASE_URL=
# 카카오 로컬 API REST 키 (장소·주소 → 가까운 역). 없으면 직접 정리한 장소만 검색된다.
KAKAO_REST_API_KEY=
# 환승 1회를 몇 정거장으로 칠지 (기본 5)
TRANSFER_PENALTY=5
# 첫 화면의 시연용 표지 목록 숨기기
SHOW_DEMO=true
